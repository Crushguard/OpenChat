    <!-- Messages inbox (§4.8) -->
    <string name="messages_title">الرسائل</string>
    <!-- 1 and 2 are written as words (واحدة / اثنتان), as Arabic does with a counted noun. Counts go in
         parentheses, never after a middle dot: beside Arabic-Indic digits "·" reads as zero ("المحذوفة فقط · ٤" looks like ٤٠) -->
    <plurals name="messages_chip_all">
        <item quantity="zero">الكل</item>
        <item quantity="one">الكل (واحدة غير مقروءة)</item>
        <item quantity="two">الكل (اثنتان غير مقروءتين)</item>
        <item quantity="few">الكل (%d غير مقروءة)</item>
        <item quantity="many">الكل (%d غير مقروءة)</item>
        <item quantity="other">الكل (%d غير مقروءة)</item>
    </plurals>
    <string name="messages_chip_deleted">المحذوفة فقط (%d)</string>
    <string name="messages_info_all">اقرأ هنا ولن يُظهر WhatsApp العلامتين الزرقاوين. تظهر الصور عندما يتضمّن الإشعار معاينة، أما الرسائل الصوتية والملفات فتظهر بأسمائها.</string>
    <string name="messages_info_deleted">لا يُحتفظ إلا بالرسائل التي حذفها المرسل. وتُتجاهل الدردشات المستثناة تمامًا.</string>
    <string name="messages_empty_title">لا شيء هنا بعد</string>
