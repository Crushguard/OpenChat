    <string name="clear_recents_title">Очистить недавние номера?</string>
    <plurals name="clear_recents_body">
        <item quantity="one">Удаляет %d номер с главного экрана. В WhatsApp ничего не изменится.</item>
        <item quantity="few">Удаляет %d номера с главного экрана. В WhatsApp ничего не изменится.</item>
