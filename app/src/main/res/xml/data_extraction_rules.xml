<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nothing of the app's own data leaves the phone, neither in cloud backup nor in a device-to-device
  transfer (android:allowBackup="false" alone stops only the cloud backup there). The captured messages, the media
  copies and the settings stay on this phone, as the gate promises ("Nothing leaves your phone").
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
