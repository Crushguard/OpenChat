<resources>
    <!-- Second account (design map §4.14): entry state -->
    <string name="second_title">दूसरा अकाउंट</string>
    <string name="second_entry_title">दूसरा WhatsApp, यहीं पर</string>
    <string name="second_entry_body">यह इस ऐप में एक WhatsApp Web सेशन लिंक करता है। इसे दूसरे अकाउंट के लिए इस्तेमाल करें, या अपना वही अकाउंट दूसरे फ़ोन पर चलाने के लिए।</string>
    <string name="second_entry_callout">आपको दूसरे फ़ोन की ज़रूरत होगी। यहाँ एक QR कोड दिखेगा; उसे उस फ़ोन पर WhatsApp › लिंक किए गए डिवाइस › डिवाइस लिंक करें में जाकर स्कैन करें।</string>
    <string name="second_scan">QR स्कैन करें</string>
    <string name="second_entry_hint">लिंक रहने तक एक सूचना दिखती रहेगी। Android के लिए यह ज़रूरी है।</string>

    <!-- Second account: linking / linked bar -->
    <string name="second_linking">लिंक हो रहा है…</string>
    <string name="second_reload">रीलोड करें</string>
    <string name="second_log_out">लॉग आउट करें</string>

    <!-- Log out confirmation (§4.20) and toasts (§4.21) -->
    <string name="logout_title">लिंक किए गए अकाउंट से लॉग आउट करें?</string>
    <string name="logout_body">इस फ़ोन पर सेशन खत्म हो जाएगा। दूसरा फ़ोन पहले की तरह चलता रहेगा।</string>
    <string name="logout_stay">लिंक रहने दें</string>
    <string name="logout_confirm">लॉग आउट करें</string>
    <string name="toast_reloading">रीलोड हो रहा है…</string>
    <string name="toast_logged_out">लॉग आउट हो गया</string>
    <string name="toast_linked">लिंक हो गया</string>
