    <!-- Contact us (design map §4.18) -->
    <string name="contact_title">संपर्क करें</string>
    <string name="contact_intro">कोई नंबर जो नहीं खुलता, कोई मैसेज जो वापस नहीं मिला, या कोई आइडिया। यह सीधे टीम तक पहुँचता है।</string>
    <string name="contact_placeholder">क्या हुआ, और किस स्क्रीन पर?</string>
    <string name="contact_email_label">ईमेल · वैकल्पिक, सिर्फ़ तब जब आपको जवाब चाहिए</string>
    <string name="contact_callout">इसके साथ ऐप वर्शन और Android वर्शन भेजा जाता है। आपके नंबर या मैसेज कभी नहीं।</string>
    <string name="contact_send">भेजें</string>
