    <string name="rating_body">आपकी सच्ची रेटिंग दूसरे लोगों को ऐसा ऐप ढूँढने में मदद करती है जो एक टैप में किसी भी नंबर पर चैट खोल दे।</string>
    <plurals name="rating_star_cd">
        <item quantity="one">5 में से %d सितारा</item>
        <item quantity="other">5 में से %d सितारे</item>
    </plurals>
    <string name="rating_hint_tap">किसी सितारे पर टैप करें</string>
    <string name="rating_hint_1">यह जानकर दुख हुआ</string>
    <string name="rating_hint_2">हम इससे बेहतर कर सकते हैं</string>
    <string name="rating_hint_3">धन्यवाद, हमें और बताएँ</string>
    <string name="rating_hint_4">खुशी है कि यह काम आया</string>
    <string name="rating_hint_5">धन्यवाद!</string>
