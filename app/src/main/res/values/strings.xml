<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">OpenChat</string>

    <!-- Links, sharing and feedback (rulings R11, R16) -->
    <string name="support_email" translatable="false">support@piptechnologies.com</string>
    <string name="privacy_policy_url" translatable="false">https://piptechnologies.com/openchat/privacy</string>
    <!-- Message the user sends with Settings › Share app, through another app they pick (a chat, email…). "OpenChat" is the app name: keep it. Keep the Play Store link at the end exactly as it is. -->
    <string name="share_app_text">OpenChat opens a chat with any number, no contact saved. https://play.google.com/store/apps/details?id=com.piptechnologies.openchat</string>
    <!-- Support-facing (read by the team, rulings R11, R16): stays English in every language. -->
    <string name="feedback_subject" translatable="false">OpenChat feedback</string>

    <!-- Launch and onboarding (design map §4.1, §4.2) -->
    <!-- One line after a small heart icon at the bottom of the launch screen and of both onboarding slides: three short promises (the app is free, shows no ads, needs no account) separated by middle dots (·). Keep the dots and keep it on one line (max ~40 characters). -->
    <string name="splash_honesty">Free · No ads · No account</string>
    <!-- Onboarding slide 1: small text button at the top end that skips the introduction and opens the app. Max ~14 characters. -->
    <string name="onboarding_skip">Skip</string>
    <!-- Onboarding slide 1: title (large, centred, up to two lines). -->
    <string name="onboarding_1_title">Chat with any number</string>
    <!-- Onboarding slide 1: text under the title. "Send" is the green Send Message button on the home screen (home_send). WhatsApp, WhatsApp Business and Telegram are app names: keep them. -->
    <string name="onboarding_1_body">Type or paste a number, tap Send. It opens in WhatsApp, WhatsApp Business or Telegram. Nothing is saved to your contacts.</string>
    <!-- Onboarding slide 1, in the picture of the home screen: the line next to a green check mark under the Send button. Keep it to one line (max ~45 characters). -->
    <string name="onboarding_1_check">Not added to your contacts</string>
    <!-- Onboarding slide 1, in the picture of the home screen: the label of the green Send button. Use the same words as the home screen's button (home_send). Max ~28 characters. -->
    <string name="onboarding_1_send">Send Message</string>
    <string name="onboarding_1_sample_number" translatable="false">812 3456 7890</string>
    <!-- Onboarding slide 2: title (large, centred, up to two lines). The four tools share one Android permission (notification access). -->
    <string name="onboarding_2_title">Four tools, one permission</string>
    <!-- Onboarding slide 2: text under the title. "Blue ticks" are WhatsApp's read receipts: use the name WhatsApp uses for them in your language, as in tool_unseen_title. -->
    <string name="onboarding_2_body">Read without blue ticks, recover what senders delete, run a second account. Everything stays on this phone.</string>
    <!-- Onboarding slide 1: full-width main button that goes to slide 2. -->
    <string name="onboarding_next">Next</string>
    <!-- Onboarding slide 2 (the last one): full-width main button that ends the introduction and opens the home screen. -->
    <string name="onboarding_start">Get started</string>

    <!-- Tool titles (Home tool rows, onboarding slide 2) -->
    <!-- Title of the tool that shows WhatsApp messages without sending read receipts. "Blue ticks" are WhatsApp's read receipts: use the name WhatsApp uses for them in your language. One line on the home screen (max ~28 characters; longer is cut off with …). -->
    <string name="tool_unseen_title">Read without blue ticks</string>
    <!-- Title of the tool that keeps WhatsApp messages after their sender deleted them. One line on the home screen (max ~28 characters). -->
    <string name="tool_deleted_title">Recover deleted messages</string>
    <!-- Title of the tool that keeps photos, videos, voice notes and documents deleted in WhatsApp. One line on the home screen (max ~28 characters). -->
    <string name="tool_media_title">Recover deleted media</string>
    <!-- Title of the tool that runs a second WhatsApp account (through WhatsApp Web) inside this app. One line on the home screen (max ~28 characters). -->
    <string name="tool_second_title">Open a second account</string>

    <!-- Notification access gate (design map §4.7) -->
    <!-- Title of the notification access screen (large, centred). "Notification access" is the Android permission that lets an app read the notifications of other apps. -->
    <string name="gate_title">Allow notification access</string>
    <!-- Notification access screen: text under the title. -->
    <string name="gate_body">Deleted messages and media are kept from WhatsApp notifications. Nothing leaves your phone.</string>
    <!-- Notification access screen: full-width main button, after an external-link icon; opens Android's notification access settings. Max ~30 characters. -->
    <string name="gate_open_settings">Open settings</string>
    <!-- Notification access screen: the same button, next to a spinner, while the app waits for the user to come back from Android's settings. Max ~30 characters. -->
    <string name="gate_waiting">Waiting for Android…</string>
    <!-- Notification access screen: hint under the Open settings button. Message Recovery and Media Recovery are the tools "Recover deleted messages" and "Recover deleted media": one permission turns on both. -->
    <string name="gate_hint_before">One grant covers Message Recovery and Media Recovery.</string>
    <!-- Notification access screen, once access is on: full-width main button that opens the tool the user came from. -->
    <string name="gate_continue">Continue</string>
    <!-- Notification access screen, once access is on: hint under Continue. "Settings" is the phone's settings, where the user just turned access on. -->
    <string name="gate_hint_after">Turn it off anytime in Settings.</string>
    <!-- Top bar title of the notification access screen when it was opened from a messages tool (Read without blue ticks or Recover deleted messages). One line, max ~30 characters. -->
    <string name="gate_bar_messages">Messages</string>
    <!-- Top bar title of the notification access screen when it was opened from the Recover deleted media tool. One line, max ~30 characters. -->
    <string name="gate_bar_media">Deleted media</string>
    <!-- Top bar title of the notification access screen when it was opened from Settings; use the same words as the Settings card (settings_access). One line, max ~30 characters. -->
    <string name="gate_bar_settings">Notification access</string>

    <!-- Second-account foreground service notification (design map §4.14, §5.4) -->
    <!-- Name of the notification category of the second account, listed in Android's notification settings for this app. Same words as second_title. -->
    <string name="second_notification_channel">Second account</string>
    <!-- Title of the ongoing notification shown while the second WhatsApp account is linked. -->
    <string name="second_notification_title">Second account linked</string>
    <!-- Text of that ongoing notification. "OpenChat" is the app name: keep it. -->
    <string name="second_notification_text">Tap to open OpenChat</string>
    <!-- Button on that ongoing notification: opens the app. One short word (max ~12 characters). -->
    <string name="second_notification_open">Open</string>

    <!-- Time labels (§5.1), put together in ui/components/TimeFormat.kt. Weekday and month names ("Mon", "22 Sep")
         and the clock ("14:26") come from the language's own date formats, not from here. -->
    <!-- Time label at the end of a Recent numbers row for a number used less than a minute ago. A compact label in a list: keep it short. -->
    <string name="time_now">Now</string>
    <!-- Day header over the items from today: Deleted media ("Today · 2") and the day pill in a conversation, which shows it in capitals ("TODAY"). -->
    <string name="time_today">Today</string>
    <!-- Time label and day header for anything from yesterday: Recent numbers rows, Messages inbox rows, day headers. A compact label in a list: keep it short. -->
    <string name="time_yesterday">Yesterday</string>
    <!-- Time label at the end of a Recent numbers row: minutes since the number was used today (%d = 1 to 59), e.g. "5m". A compact label in a list, not a sentence: use the language's shortest abbreviation for minutes. -->
    <string name="time_minutes_short">%dm</string>
    <!-- Time label at the end of a Recent numbers row: hours since the number was used today (%d = 1 to 23), e.g. "2h". A compact label in a list, not a sentence: use the language's shortest abbreviation for hours. -->
    <string name="time_hours_short">%dh</string>

    <!-- Shared components (ui/components). -->
    <!-- Accessibility label of the back arrow at the start of every top bar. Read by TalkBack, never shown. -->
    <string name="cd_back">Back</string>
    <!-- Status chip text: the tool is off because notification access is not granted (gate screen and top bars). Chip label, one or two words, max ~10 characters. -->
    <string name="chip_off">Off</string>
    <!-- Status chip text: notification access is granted and recovery is running (gate screen and top bars). Chip label, one word, max ~10 characters. -->
    <string name="chip_active">Active</string>
    <!-- Status chip text: the user paused recovery for this tool (Messages and Deleted media top bars). Chip label, one word, max ~10 characters. -->
    <string name="chip_paused">Paused</string>
    <!-- Status chip text: the second WhatsApp account is linked to this phone (Second account top bar). Chip label, one word, max ~10 characters. -->
    <string name="chip_linked">Linked</string>
</resources>
